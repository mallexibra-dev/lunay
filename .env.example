# Database PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/db_name"

# Base URL untuk panggilan API sisi server (opsional)
API_BASE_URL="http://localhost:3000"

# Base URL API yang dipakai di browser (opsional)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Variabel autentikasi (BETTER_AUTH_SECRET, BETTER_AUTH_URL, kredensial
